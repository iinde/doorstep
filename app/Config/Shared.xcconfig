// Shared.xcconfig
// Minimal shared configuration for scaffold tool customization
// All other settings use Xcode project defaults
// Generated by XcodeBuildMCP

// ==========================================
// Project Identity
// ==========================================
PRODUCT_NAME = OpenRing
PRODUCT_DISPLAY_NAME = Doorstep
PRODUCT_BUNDLE_IDENTIFIER = com.openring.app
MARKETING_VERSION = 0.7.0
CURRENT_PROJECT_VERSION = 15

// ==========================================
// Platform Configuration
// ==========================================
MACOSX_DEPLOYMENT_TARGET = 14.0

// ==========================================
// Info PLIST
// ==========================================
GENERATE_INFOPLIST_FILE = YES

// ==========================================
// Entitlements
// ==========================================
// AI agents can modify Config/OpenRing.entitlements to add capabilities
CODE_SIGN_ENTITLEMENTS = Config/OpenRing.entitlements

// ==========================================
// Framework Embedding
// ==========================================
// Ensure SPM binary frameworks (like WebRTC) are embedded in app
LD_RUNPATH_SEARCH_PATHS = $(inherited) @executable_path/../Frameworks @loader_path/../Frameworks
ALWAYS_EMBED_SWIFT_STANDARD_LIBRARIES = YES
// Menu bar only: no Dock icon, not in the Cmd-Tab switcher.
INFOPLIST_KEY_LSUIElement = YES

// Privacy prompts. Without the microphone one, macOS terminates the app on Hold to talk.
INFOPLIST_KEY_NSMicrophoneUsageDescription = Doorstep uses your microphone when you hold to talk to someone at your door.
INFOPLIST_KEY_NSLocalNetworkUsageDescription = Doorstep checks your local network to find the fastest route to your camera video.

// Updates (Sparkle). The feed is the appcast attached to the newest GitHub release of
// DOORSTEP_RELEASES_REPO, a public repo that holds only release downloads.
// SUPublicEDKey is the public half of the EdDSA key in the release Mac's login Keychain.
INFOPLIST_FILE = Support/Info.plist
DOORSTEP_RELEASES_REPO = iinde/doorstep-releases

// Brand: icon and menu bar marks are rendered by scripts/brand/render-brand.swift.
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon

// Parcels: "Add to Calendar" asks only to add events, never to read your calendar.
INFOPLIST_KEY_NSCalendarsWriteOnlyAccessUsageDescription = Doorstep adds the days your parcels are due to your calendar when you ask it to.

// Optional transcripts of what visitors say (on-device speech recognition).
INFOPLIST_KEY_NSSpeechRecognitionUsageDescription = Doorstep can turn what visitors say at your door into text, on this Mac, if you switch it on.
